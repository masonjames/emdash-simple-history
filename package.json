{
	"name": "emdash-simple-history",
	"version": "0.2.0",
	"description": "Lightweight activity history for EmDash CMS content changes.",
	"type": "module",
	"main": "dist/compat/index.mjs",
	"exports": {
		".": {
			"types": "./dist/compat/index.d.mts",
			"default": "./dist/compat/index.mjs"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist/*.mjs",
		"dist/*.d.mts",
		"dist/manifest.json",
		"dist/compat",
		"emdash-plugin.jsonc",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "emdash-plugin build && tsdown src/index.ts --out-dir dist/compat --format esm --dts --clean",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "pnpm build && pnpm typecheck && pnpm test && pnpm test:sandbox && pnpm bundle",
		"validate": "emdash-plugin validate",
		"bundle": "emdash-plugin bundle",
		"test:sandbox": "vitest run --config vitest.sandbox.config.ts"
	},
	"keywords": [
		"emdash",
		"cms",
		"plugin",
		"history",
		"audit",
		"activity"
	],
	"author": "Mason James",
	"license": "MIT",
	"peerDependencies": {
		"emdash": ">=1.0.1"
	},
	"dependencies": {
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"emdash": "1.0.1",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"@emdash-cms/plugin-cli": "0.13.1",
		"@types/node": "^24.10.13",
		"@emdash-cms/plugin-test": "0.2.6",
		"vite": "^8.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/masonjames/emdash-simple-history.git"
	},
	"bugs": {
		"url": "https://github.com/masonjames/emdash-simple-history/issues"
	},
	"homepage": "https://github.com/masonjames/emdash-simple-history",
	"packageManager": "pnpm@10.28.0",
	"publishConfig": {
		"access": "public"
	},
	"plugin": {
		"id": "simple-history"
	},
	"types": "dist/compat/index.d.mts"
}
